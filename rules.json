[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "content-disposition", "operation": "remove" },
        { "header": "content-type", "operation": "set", "value": "video/mp4" },
        { "header": "access-control-allow-origin", "operation": "set", "value": "*" },
        { "header": "access-control-allow-methods", "operation": "set", "value": "GET, HEAD, OPTIONS" },
        { "header": "access-control-allow-headers", "operation": "set", "value": "*, Range, Content-Range, Accept-Ranges, Origin, Referer, User-Agent, X-Requested-With" },
        { "header": "access-control-expose-headers", "operation": "set", "value": "Content-Range, Content-Length, Accept-Ranges, *" }
      ]
    },
    "condition": {
      "regexFilter": "^https?://.*\\.mypikpak\\.(com|net)/(download|file|media)/.*",
      "resourceTypes": ["media", "xmlhttprequest", "other", "sub_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "access-control-allow-origin", "operation": "set", "value": "*" },
        { "header": "access-control-allow-methods", "operation": "set", "value": "GET, POST, OPTIONS, HEAD, PUT" },
        { "header": "access-control-allow-headers", "operation": "set", "value": "*, x-device-name, x-device-id, x-device-model, x-device-sign, x-client-id, x-client-version, x-package-name, x-captcha-token, x-os-version, x-platform-version, x-net-work-type, Content-Type, Authorization, Range, Accept, Origin, User-Agent, X-Requested-With" },
        { "header": "access-control-expose-headers", "operation": "set", "value": "Content-Range, Content-Length, Accept-Ranges, *" }
      ]
    },
    "condition": {
      "regexFilter": "^https?://(api-drive|user)\\.mypikpak\\.(com|net)/.*",
      "resourceTypes": ["xmlhttprequest", "other"]
    }
  }
]
